node_modules/
dist/
.turbo/
*.tsbuildinfo

# 取数产物：原始解包数据不入库（体积大，且可由 manifest 里的 SHA 重新取）
data/raw/

# 构建期重建，不入库
data/al.sqlite
data/al.sqlite-*
# 客户端筛选索引由 pipeline#client-index 从 al.sqlite 现算（§6.2 顺序第 3 步）；
# 提交它等于允许「旧索引配新页面」这种CI 里查不出的状态
apps/web/public/data/

# LocalAdapter 输出，不入库（上云走 R2）
data/images/
# 无图模式（§8.5 未授权）下台账引用的对象不在任何地方，提交它等于给页面留一批死链；
# 阶段 3B 图真正上 R2 时随图一起转入库
data/images.manifest.json

# 探针与临时产物
.probe-*
.gate.json
.drift-report.md
reports/

.next/
out/

# Next 生成的类型声明与构建缓存
next-env.d.ts
